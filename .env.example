# GitHub Actions variables
VITE_API_BASE_URL=https://api.example.com
KAMAL_HOST=app.example.com
KAMAL_IMAGE=owner/bank-frontend
KAMAL_REGISTRY_SERVER=ghcr.io
KAMAL_SSH_USER=root

# GitHub Actions secrets consumed by .kamal/secrets
KAMAL_REGISTRY_USERNAME=github-user
KAMAL_REGISTRY_PASSWORD=github-token
KAMAL_SERVER_IP=203.0.113.10
KAMAL_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----"
